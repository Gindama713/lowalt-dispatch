# 本地开发环境变量样例。
# 复制成 .env 再填真实值。.env 已被 .gitignore 排除，**永远不会进仓库**。
# 提交前请再确认一次：git status 里不应该出现 .env。

APP_ENV=dev

# ---- 只想本地跑、不开通任何云资源？用 ops/local.env.example，别用本文件 ----
#   cp ops/local.env.example .env
#   docker compose -f ops/docker-compose.yml up -d
# 本文件是"混合模板"：云相关项留空，本地项只给最小默认值。

# ---- 独立 FastAPI（python -m services.api，当前进程就能用，不需要云资源）----
# 与助手上的 /api/dispatch 不是同一个进程。memory：进程内 SQLite，退出即失。
# sqlite：本地文件，默认 data/api.sqlite，已在 .gitignore。两种都还不是 PostgreSQL / Redis。
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/api.sqlite
API_HOST=127.0.0.1
API_PORT=8000

# 规划器入口，写成 模块:函数。留空则调用已入库的几何基线 planner.astar:plan_scenario。
PLANNER_ENTRY=

# 独立进程里的 M3 调用点，写成 模块:函数。留空表示这个进程不调用外部 Agent。
# 规划完成后会把 task_id / snapshot_id / route_id 传进去，但本服务不会按返回值改路线。
# 不要把密钥写在这里。助手上的本地调度链路不读这个变量。
AGENT_ENTRY=

# PostgreSQL / Redis 的通用别名。和下面的 RDS_DSN、DCS_HOST 一样，只是配置位：
# 填了以后独立进程的 /health 会显示 configured=true、connected=false，本版本不会去连接。
DATABASE_URL=
REDIS_URL=

# ---- 华为云（11/09 预检后再填，先别急着开通付费资源）----
HUAWEI_CLOUD_REGION=
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
RDS_DSN=
DCS_HOST=
DCS_PORT=6379
OBS_BUCKET=

# ---- 模型服务（MaaS）----
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_MODEL=
# 完整chat/completions接口地址优先；不填时使用MAAS_BASE_URL/chat/completions。
MAAS_CHAT_ENDPOINT=

# ---- M3：默认全部在本地；配置云资源后显式切换，不会自动降级冒充成功 ----
M3_RUN_MODE=mock
M3_LEDGER_BACKEND=sqlite
M3_SQLITE_PATH=logs/agent/m3-ledger.sqlite3
M3_AUDIT_DIR=logs/agent/runs
M3_CACHE_BACKEND=none
DCS_PASSWORD=
# 云 DCS 必须 true；本地 Docker Redis 没有证书，必须改 false，否则连不上。
DCS_TLS=true
M3_ARCHIVE_BACKEND=local
M3_ARCHIVE_DIR=logs/agent/archive
OBS_ENDPOINT=
HUAWEI_CLOUD_SECURITY_TOKEN=

# ---- 云边消息 ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID_CLOUD=cloud-api
MQTT_CLIENT_ID_EDGE=edge-agent
MQTT_USERNAME=
MQTT_PASSWORD=
# false只适用于本机开发；远程MQTT要求TLS和认证。
MQTT_TLS=false
MQTT_CA_FILE=
M3_VEHICLE_ID=px4-sitl-1
M3_ACK_TIMEOUT_S=3

# ---- 飞控接口（A 填）----
FC_TYPE=            # px4 | ardupilot
MAVSDK_ADDRESS=udpin://0.0.0.0:14540
