# 复制为本目录下的 .env 后填写。不要把填好的 .env 提交到仓库。
# 本文件只预留变量名与默认值，不含任何真实 token。

# 天地图「浏览器端」应用 token（用户自行申请，阶段 0 调通瓦片出图用）
VITE_TIANDITU_TOKEN=

# Cesium ion Community access token（免费档为社区授权，非商业/评估用途）
VITE_CESIUM_ION_TOKEN=

# 后端 API 根地址
VITE_API_BASE=http://127.0.0.1:8000

# 工程锚点：成都天府新区兴隆湖湖心（WGS84 / CGCS2000）
# 详见 docs/锚点决议.md。水平取 6 位小数；h 为暂定正高，当作椭球高使用。
VITE_ANCHOR_LAT=30.399075
VITE_ANCHOR_LON=104.085889
VITE_ANCHOR_H=474
