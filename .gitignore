# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ---------- 环境变量与密钥（严禁提交）----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ---------- 飞控与仿真原始产物（体积大，走 OBS 归档）----------
*.ulg
*.bag
*.db3
*.mcap
logs/
logs_*/

# ---------- API 本地库 ----------
# SQLite 是开发存储，不是评测证据。PostgreSQL 尚未接入。
data/
*.sqlite
*.sqlite3

# ---------- 结果目录 ----------
# 真实评测结果（run_mode=real）在冻结版本时提交，属于证据。
# mock 产物永不入库：它每次运行都会因时间戳变化产生 diff，而且一旦进了仓库，
# 就有被截图引用的风险。"mock 数字不可引用"要做成结构约束，而不是一句承诺。
results/*_MOCK.csv
results/*_MOCK.meta.json
results/*.tmp
results/meta/

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 助手的工作笔记与缓存（不进公开仓库）----------
# 《事实文档.md》才是给团队看的项目现状；这里是我自己的过程记录。
.workbuddy/
.workbuddy-ai/
